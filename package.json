{
  "name": "home-floor-planner",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:watch": "ng build --watch --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "lint:e2e": "npx eslint \"e2e/**/*.ts\"",
    "test": "ng test --watch=false",
    "test:architecture": "ng test --watch=false --include=src/architecture/**/*.spec.ts",
    "test:watch": "ng test",
    "e2e": "ng e2e"
  },
  "private": true,
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@angular/cdk": "^21.2.7",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^21.2.7",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.1",
    "@types/node": "^25.6.0",
    "angular-eslint": "21.3.1",
    "archunit": "^2.1.69",
    "eslint": "^10.0.3",
    "jsdom": "^28.0.0",
    "playwright-ng-schematics": "^21.0.10",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  }
